import React, { useEffect, useState } from "react";
import { useWebSocket } from "../WebSocketContext";

const Grid = ({ gameId }) => {
  const [boxes, setBoxes] = useState([]);
  const boxSize = 50; // Size of each box in the grid
  const ws = useWebSocket(); // Use WebSocket context

  useEffect(() => {
    if (!ws) return;

    ws.onopen = () => {
      console.log("WebSocket connected");
      fetchGridData();
    };

    const fetchGridData = () => {
      if (ws.readyState === WebSocket.OPEN) {
        ws.send(
          JSON.stringify({
            type: "get_grids",
            payload: { gameId },
          })
        );
      } else {
        console.log("WebSocket not ready, retrying...");
        setTimeout(fetchGridData, 500);
      }
    };

    ws.onmessage = (event) => {
      const message = JSON.parse(event.data);
      if (message.type === "new_grids") {
        setBoxes(message.payload);
      } else if (message.type === "new_box_update") {
        const updatedBox = message.payload;
        setBoxes((prevBoxes) =>
          prevBoxes.map((box) =>
            box.BoxId === updatedBox.BoxId ? { ...box, ...updatedBox } : box
          )
        );
      }
    };

    ws.onclose = (event) => {
      console.log("WebSocket disconnected", event);
    };

    ws.onerror = (error) => {
      console.error("WebSocket error", error);
    };

    return () => {
      ws.removeEventListener("message", ws.onmessage);
    };
  }, [gameId, ws]);

  const handleClick = (gameId, playerId, row, col, edge) => {
    if (ws) {
      const payload = {
        gameId,
        playerId,
        row,
        col,
        edge,
      };

      ws.send(
        JSON.stringify({
          type: "send_box_update",
          payload,
        })
      );
    }
  };

  return (
    <svg
      width={boxSize * 5}
      height={boxSize * 5}
      style={{ border: "1px solid black" }}
    >
      {boxes.map((box) => {
        const { BoxId, Row, Col } = box;
        const x = Col * boxSize;
        const y = Row * boxSize;

        return (
          <g key={BoxId}>
            {/* Top Edge */}
            <line
              x1={x}
              y1={y}
              x2={x + boxSize}
              y2={y}
              stroke="black"
              strokeWidth="2"
              onClick={() => handleClick(gameId, 1, Row, Col, "TopEdge")} // Replace 1 with the actual playerId
              style={{ cursor: "pointer" }}
            />
            {/* Left Edge */}
            <line
              x1={x}
              y1={y}
              x2={x}
              y2={y + boxSize}
              stroke="black"
              strokeWidth="2"
              onClick={() => handleClick(gameId, 1, Row, Col, "LeftEdge")} // Replace 1 with the actual playerId
              style={{ cursor: "pointer" }}
            />
            {/* Right Edge */}
            <line
              x1={x + boxSize}
              y1={y}
              x2={x + boxSize}
              y2={y + boxSize}
              stroke="black"
              strokeWidth="2"
              onClick={() => handleClick(gameId, 1, Row, Col, "RightEdge")} // Replace 1 with the actual playerId
              style={{ cursor: "pointer" }}
            />
            {/* Bottom Edge */}
            <line
              x1={x}
              y1={y + boxSize}
              x2={x + boxSize}
              y2={y + boxSize}
              stroke="black"
              strokeWidth="2"
              onClick={() => handleClick(gameId, 1, Row, Col, "BottomEdge")} // Replace 1 with the actual playerId
              style={{ cursor: "pointer" }}
            />
          </g>
        );
      })}
    </svg>
  );
};

const App = () => {
  const [gameId, setGameId] = useState(2); // Example GameId, update as needed

  return (
    <div>
      <h1>Clickable SVG Grid</h1>
      <Grid gameId={gameId} />
    </div>
  );
};

export default App;
